<!doctype html>
<html lang="en" xmlns:og="http://ogp.me/ns#">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet">
  <squarespace:headers />
</head>
<body id="{squarespace.page-id}" class="{squarespace.page-classes}">
  <a class="pom-skip" href="#page">Skip to content</a>

  <header class="pom-header">
    <a class="pom-logo" href="/">
      <img class="pom-logo-mark" src="/assets/logo-mark.svg" alt="" width="36" height="42">
      <span class="pom-wordmark">
        <span>Pacesetters</span>
        <span>Outreach Ministry</span>
      </span>
    </a>

    <div class="pom-header-tools">
      <a class="pom-btn pom-btn-light pom-join" href="/events">Join Online <span class="pom-arrow" aria-hidden="true"></span></a>
      <button class="pom-menu-toggle" type="button" aria-expanded="false" aria-controls="pom-drawer">
        <span class="pom-menu-bars" aria-hidden="true"></span>
        <span class="pom-sr">Menu</span>
      </button>
    </div>

    <nav id="pom-drawer" class="pom-sidenav" aria-label="Primary" data-pom-nav>
      <div class="pom-nav-fallback" data-nav-fallback>
        <ul class="pom-nav-list">
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/store">Store</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="pom-nav-cms" data-nav-cms>
        <squarespace:navigation navigationId="mainNav" template="nav-list" />
      </div>
    </nav>
  </header>

  <main id="page" role="main" data-content-field="main-content">
    {squarespace.main-content}
  </main>

  <footer class="pom-footer">
    <div class="pom-footer-top">
      <a class="pom-logo" href="/">
        <img class="pom-logo-mark" src="/assets/logo-mark.svg" alt="" width="36" height="42">
        <span class="pom-wordmark">
          <span>Pacesetters</span>
          <span>Outreach Ministry</span>
        </span>
      </a>

      <nav class="pom-footer-nav" aria-label="Footer" data-pom-nav>
        <div class="pom-nav-fallback" data-nav-fallback>
          <ul class="pom-nav-list">
            <li><a href="/about">About</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/store">Store</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="pom-nav-cms" data-nav-cms>
          <squarespace:navigation navigationId="footerNav" template="nav-list" />
        </div>
      </nav>

      <div class="pom-social">
        <a href="https://www.facebook.com" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M14.5 8.5V6.8c0-.7.5-1 1.2-1H17V3h-2.2C12.2 3 11 4.4 11 6.6v1.9H9v2.8h2V21h3.5v-9.7h2.3l.4-2.8h-2.7z"/></svg>
        </a>
        <a href="https://www.instagram.com" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 7.4A4.6 4.6 0 1 0 12 16.6 4.6 4.6 0 0 0 12 7.4zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6zM17.4 6.8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM12 4.2c1.5 0 1.7 0 2.3.1.6 0 1 .1 1.3.3.4.1.6.3.9.6.3.3.5.5.6.9.2.3.3.7.3 1.3.1.6.1.8.1 2.3s0 1.7-.1 2.3c0 .6-.1 1-.3 1.3-.1.4-.3.6-.6.9-.3.3-.5.5-.9.6-.3.2-.7.3-1.3.3-.6.1-.8.1-2.3.1s-1.7 0-2.3-.1c-.6 0-1-.1-1.3-.3-.4-.1-.6-.3-.9-.6-.3-.3-.5-.5-.6-.9-.2-.3-.3-.7-.3-1.3-.1-.6-.1-.8-.1-2.3s0-1.7.1-2.3c0-.6.1-1 .3-1.3.1-.4.3-.6.6-.9.3-.3.5-.5.9-.6.3-.2.7-.3 1.3-.3.6-.1.8-.1 2.3-.1zm0-1.6c-1.5 0-1.7 0-2.4.1-.6 0-1.1.1-1.5.3-.4.2-.8.4-1.2.8-.4.4-.6.8-.8 1.2-.2.4-.3.9-.3 1.5-.1.7-.1.9-.1 2.4s0 1.7.1 2.4c0 .6.1 1.1.3 1.5.2.4.4.8.8 1.2.4.4.8.6 1.2.8.4.2.9.3 1.5.3.7.1.9.1 2.4.1s1.7 0 2.4-.1c.6 0 1.1-.1 1.5-.3.4-.2.8-.4 1.2-.8.4-.4.6-.8.8-1.2.2-.4.3-.9.3-1.5.1-.7.1-.9.1-2.4s0-1.7-.1-2.4c0-.6-.1-1.1-.3-1.5-.2-.4-.4-.8-.8-1.2-.4-.4-.8-.6-1.2-.8-.4-.2-.9-.3-1.5-.3-.7-.1-.9-.1-2.4-.1z"/></svg>
        </a>
      </div>
    </div>

    <nav class="pom-legal" aria-label="Legal" data-pom-nav>
      <div class="pom-nav-fallback" data-nav-fallback>
        <ul class="pom-nav-list">
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms">Terms &amp; Conditions</a></li>
          <li><a href="/help">Help &amp; Support</a></li>
        </ul>
      </div>
      <div class="pom-nav-cms" data-nav-cms>
        <squarespace:navigation navigationId="legalNav" template="nav-list" />
      </div>
    </nav>
  </footer>

  <script src="/scripts/site.js"></script>
  <squarespace:footers />
</body>
</html>
