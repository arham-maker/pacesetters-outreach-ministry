<!doctype html>
<html lang="en" xmlns:og="http://ogp.me/ns#">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  {squarespace-headers}
</head>
<body id="{squarespace.page-id}" class="{squarespace.page-classes}">
  <a class="pom-skip" href="#page">Skip to content</a>

  <header class="pom-header">
    <a class="pom-logo" href="/">
      <img class="pom-logo-mark" src="/assets/logo.png" alt="Pacesetters Outreach Ministry" width="200" height="48">
    </a>

    <div class="pom-header-tools">
      <button class="pom-menu-toggle" type="button" aria-expanded="false" aria-controls="pom-drawer">
        <span class="pom-menu-bars" aria-hidden="true"></span>
        <span class="pom-sr">Menu</span>
      </button>
    </div>

    <nav id="pom-drawer" class="pom-sidenav" aria-label="Primary" data-pom-nav>
      <div class="pom-nav-fallback" data-nav-fallback>
        <ul class="pom-nav-list">
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/store">Store</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="pom-nav-cms" data-nav-cms>
        <squarespace:navigation navigationId="mainNav" template="nav-list" />
      </div>
    </nav>
  </header>

  <main id="page" role="main" data-content-field="main-content">
    {squarespace.main-content}
  </main>

  <footer class="pom-footer">
    <div class="pom-footer-top">
      <a class="pom-logo" href="/">
        <img class="pom-logo-mark" src="/assets/logo.png" alt="Pacesetters Outreach Ministry" width="200" height="48">
      </a>

      <nav class="pom-footer-nav" aria-label="Footer" data-pom-nav>
        <div class="pom-nav-fallback" data-nav-fallback>
          <ul class="pom-nav-list">
            <li><a href="/about">About</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/store">Store</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="pom-nav-cms" data-nav-cms>
          <squarespace:navigation navigationId="footerNav" template="nav-list" />
        </div>
      </nav>

      <div class="pom-social" data-pom-region="site-footer-social">
        <div class="pom-fallback">
          <a href="https://www.facebook.com" aria-label="Facebook">
            <svg class="pom-social-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.4"/>
              <path d="M13.1 17.5v-5.2h1.55l.23-1.85H13.1V9.3c0-.53.15-.9.92-.9h.98V6.75c-.17-.02-.75-.07-1.43-.07-1.42 0-2.4.86-2.4 2.45v1.37H9.5v1.85h1.67v5.2h1.93z" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.instagram.com" aria-label="Instagram">
            <svg class="pom-social-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="12" cy="12" r="3.85" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="16.85" cy="7.2" r="1.05" fill="currentColor"/>
            </svg>
          </a>
        </div>
        <div class="pom-cms"><squarespace:block-field id="site-footer-social" columns="12" /></div>
      </div>
    </div>

    <nav class="pom-legal" aria-label="Legal" data-pom-nav>
      <div class="pom-nav-fallback" data-nav-fallback>
        <ul class="pom-nav-list">
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms &amp; Conditions</a></li>
          <li><a href="/support">Help &amp; Support</a></li>
        </ul>
      </div>
      <div class="pom-nav-cms" data-nav-cms>
        <squarespace:navigation navigationId="legalNav" template="nav-list" />
      </div>
    </nav>
  </footer>

  <script src="/scripts/site.js"></script>
  {squarespace-footers}
</body>
</html>
