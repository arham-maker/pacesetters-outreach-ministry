<article class="pom-product-page">
  <div class="pom-media is-books">
    {.section assetUrl}<img src="{assetUrl}?format=1500w" alt="{title}">{.end}
  </div>
  <div>
    <a class="pom-back" href="/store"><span class="pom-arrow" aria-hidden="true"></span> Back to Store</a>
    <h1>{title}</h1>
    {.section excerpt}<p class="pom-prose">{excerpt}</p>{.end}
    {.section body}<div class="pom-prose">{body}</div>{.end}
    <div class="pom-add sqs-add-to-cart-button-wrapper" data-item-id="{id}">
      <div class="sqs-add-to-cart-button">Add to Cart</div>
    </div>
  </div>
</article>
