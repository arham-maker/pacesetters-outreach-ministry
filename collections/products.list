<div class="pom-page pom-page-store">
  <section class="pom-hero is-store-resources" data-pom-region="store-hero">
    <div class="pom-hero-copy pom-fallback">
      <h1>Ministry Resources</h1>
      <p class="pom-lede">Encouragement for everyday faith.</p>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-hero" columns="12" /></div>
  </section>

  <section class="pom-intro is-store-intro" data-pom-region="store-intro">
    <div class="pom-fallback">
      <div class="pom-intro-copy">
        <p class="pom-eyebrow">Ministry Resources</p>
        <h2>Return to words that<br>encourage.</h2>
      </div>
      <div class="pom-intro-body">
        <p class="pom-prose">Explore music, sermons, and books from our ministry to support your walk of faith.</p>
        <a class="pom-link" href="#ministry-store"><span class="pom-link-text">Browse Resources</span><span class="pom-arrow is-ne" aria-hidden="true"></span></a>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-intro" columns="12" /></div>
  </section>

  <section class="pom-cats is-store-cats" data-pom-region="store-categories" aria-label="Resource categories">
    <div class="pom-fallback">
      <article>
        <div class="pom-media is-store-cat-music" role="img" aria-label="Music and CDs"></div>
        <h3>Music &amp; CDs</h3>
        <p>Music to encourage worship and reflection.</p>
      </article>
      <article>
        <div class="pom-media is-store-cat-sermons" role="img" aria-label="Sermons"></div>
        <h3>Sermons</h3>
        <p>Messages rooted in God’s<br>Word.</p>
      </article>
      <article>
        <div class="pom-media is-store-cat-books" role="img" aria-label="Books"></div>
        <h3>Books</h3>
        <p>Reading for spiritual growth and encouragement.</p>
      </article>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-categories" columns="12" /></div>
  </section>

  <section id="ministry-store" class="pom-store-grid" data-pom-region="store-grid">
    <div class="pom-fallback">
      <div class="pom-store-head">
        <p class="pom-eyebrow">Ministry Store</p>
        <h2>Browse Resources</h2>
      </div>
      <div class="pom-filters" data-filters>
        <button type="button" class="is-active" data-filter="all">All Resources</button>
        <button type="button" data-filter="music">Music &amp; CDs</button>
        <button type="button" data-filter="sermons">Sermons</button>
        <button type="button" data-filter="books">Books</button>
      </div>
      <div class="pom-products" data-product-grid>
        {.repeated section items}
        <article class="pom-product" data-category="{tags}">
          <a href="{fullUrl}">
            <div class="pom-media is-store-product">
              {.section assetUrl}<img src="{assetUrl}?format=800w" alt="{title}">{.end}
            </div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>{title}</h3>
                <span class="pom-product-price">{.section priceMoney}{priceMoney}{.or}$XX.XX{.end}</span>
              </div>
              <p class="pom-product-cat">{.section tags}{tags}{.or}Resource{.end}</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        {.or}
        <article class="pom-product" data-category="music">
          <a href="/songs-of-encouragement">
            <div class="pom-media is-store-p01" role="img" aria-label="Songs of Encouragement"></div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>Songs of Encouragement</h3>
                <span class="pom-product-price">$20.00</span>
              </div>
              <p class="pom-product-cat">Music &amp; CDs</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        <article class="pom-product" data-category="sermons">
          <a href="/hope-for-every-season">
            <div class="pom-media is-store-p02" role="img" aria-label="Hope for Every Season"></div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>Hope for Every Season</h3>
                <span class="pom-product-price">$18.00</span>
              </div>
              <p class="pom-product-cat">Sermons</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        <article class="pom-product" data-category="books">
          <a href="/rooted-in-faith">
            <div class="pom-media is-store-p03" role="img" aria-label="Rooted in Faith"></div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>Rooted in Faith</h3>
                <span class="pom-product-price">$22.00</span>
              </div>
              <p class="pom-product-cat">Books</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        <article class="pom-product" data-category="music">
          <a href="/praise-and-reflection">
            <div class="pom-media is-store-p04" role="img" aria-label="Praise and Reflection"></div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>Praise &amp; Reflection</h3>
                <span class="pom-product-price">$20.00</span>
              </div>
              <p class="pom-product-cat">Music &amp; CDs</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        <article class="pom-product" data-category="books">
          <a href="/daily-words-of-hope">
            <div class="pom-media is-store-p05" role="img" aria-label="Daily Words of Hope"></div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>Daily Words of Hope</h3>
                <span class="pom-product-price">$16.00</span>
              </div>
              <p class="pom-product-cat">Books</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        <article class="pom-product" data-category="sermons">
          <a href="/walking-with-christ">
            <div class="pom-media is-store-p06" role="img" aria-label="Walking with Christ"></div>
            <div class="pom-product-meta">
              <div class="pom-product-row">
                <h3>Walking with Christ</h3>
                <span class="pom-product-price">$18.00</span>
              </div>
              <p class="pom-product-cat">Sermons</p>
            </div>
            <span class="pom-link"><span class="pom-link-text">View Details</span><span class="pom-arrow is-ne" aria-hidden="true"></span></span>
          </a>
        </article>
        {.end}
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-grid" columns="12" /></div>
  </section>

  <section class="pom-points is-dark is-store-encourage" data-pom-region="store-encourage">
    <div class="pom-fallback">
      <h2>Make space for<br>everyday encouragement.</h2>
      <div class="pom-points-list">
        <article>
          <h3>Listen and reflect</h3>
          <p>Play music and sermons when you need quiet time with God.</p>
        </article>
        <article>
          <h3>Read and revisit</h3>
          <p>Return to messages and books that speak to your current season.</p>
        </article>
        <article>
          <h3>Grow in faith</h3>
          <p>Use these resources to encourage a deeper walk with Christ.</p>
        </article>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-encourage" columns="12" /></div>
  </section>

  <section class="pom-testimonials" data-pom-region="store-testimonials">
    <div class="pom-fallback">
      <div class="pom-testimonials-intro">
        <div>
          <p class="pom-eyebrow">Testimonials</p>
          <h2>Stories of faith<br>and hope.</h2>
          <div class="pom-quote-nav">
            <button class="pom-icon-btn is-prev" type="button" data-quote="prev" aria-label="Previous story"><span class="pom-arrow"></span></button>
            <button class="pom-icon-btn is-next" type="button" data-quote="next" aria-label="Next story"><span class="pom-arrow"></span></button>
          </div>
        </div>
      </div>
      <div class="pom-quote-wrap" data-quotes>
        <blockquote class="pom-quote is-active">
          <div class="pom-quote-mark" aria-hidden="true">“</div>
          <p>Lorem ipsum dolor sit amet consectetur. Neque rhoncus et quis in pretium augue commodo. Eget est erat auctor sit nunc urna dolor massa eget. Aliquet praesent in laoreet orci turpis et faucibus. Egestas malesuada a ut auctor euismod.</p>
          <cite>— Jane Doe</cite>
        </blockquote>
        <blockquote class="pom-quote">
          <div class="pom-quote-mark" aria-hidden="true">“</div>
          <p>Being part of this community has strengthened my faith and given me a place to belong. Every gathering reminds me that God’s love is near.</p>
          <cite>— Michael R.</cite>
        </blockquote>
        <blockquote class="pom-quote">
          <div class="pom-quote-mark" aria-hidden="true">“</div>
          <p>Saturday Night Live connects us even when we are far apart. The teaching and prayer leave me encouraged for the week ahead.</p>
          <cite>— Sarah L.</cite>
        </blockquote>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-testimonials" columns="12" /></div>
  </section>

  <section class="pom-faq" data-pom-region="store-faq">
    <div class="pom-fallback">
      <div class="pom-faq-intro"><div><p class="pom-eyebrow">FAQ</p><h2>A few helpful<br>answers.</h2></div></div>
      <div class="pom-faq-list" data-accordion>
        <div class="pom-faq-item is-open">
          <button class="pom-faq-q" type="button" aria-expanded="true">What can I find in the store? <span class="pom-faq-icon" aria-hidden="true"></span></button>
          <div class="pom-faq-a">The ministry offers music, sermon recordings, CDs, and books.</div>
        </div>
        <div class="pom-faq-item">
          <button class="pom-faq-q" type="button" aria-expanded="false">How do I learn more about a resource? <span class="pom-faq-icon" aria-hidden="true"></span></button>
          <div class="pom-faq-a">Open any resource for details, or contact the ministry with questions about a specific title.</div>
        </div>
        <div class="pom-faq-item">
          <button class="pom-faq-q" type="button" aria-expanded="false">Can I ask about current availability? <span class="pom-faq-icon" aria-hidden="true"></span></button>
          <div class="pom-faq-a">Yes. Call or email us and we’ll confirm what’s available and how to obtain it.</div>
        </div>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-faq" columns="12" /></div>
  </section>

  <section class="pom-contact is-crowd" id="get-in-touch" data-pom-region="store-contact">
    <div class="pom-fallback">
      <div class="pom-contact-copy">
        <p class="pom-eyebrow">Get in Touch</p>
        <h2>We’d love to hear from you.</h2>
        <p class="pom-contact-lead">Have a question, need prayer, or want to help?</p>
        <div class="pom-contact-meta is-icons">
          <a href="tel:3305059087">330 505-9087 <span class="pom-meta-icon is-phone" aria-hidden="true"></span></a>
          <a href="mailto:terryolivia@currently.com">terryolivia@currently.com <span class="pom-meta-icon is-mail" aria-hidden="true"></span></a>
        </div>
      </div>
      <form class="pom-form-card" data-contact-form>
        <div class="pom-field"><label for="store-name">Name</label><input id="store-name" name="name" type="text"></div>
        <div class="pom-field"><label for="store-email">Email</label><input id="store-email" name="email" type="email"></div>
        <div class="pom-field"><label for="store-message">Message</label><textarea id="store-message" name="message"></textarea></div>
        <button class="pom-link" type="submit"><span class="pom-link-text">Send Message</span><span class="pom-arrow is-ne" aria-hidden="true"></span></button>
        <p class="pom-form-note" hidden>Thank you. Add a Squarespace Form block in this region to deliver messages.</p>
      </form>
    </div>
    <div class="pom-cms"><squarespace:block-field id="store-contact" columns="12" /></div>
  </section>
</div>
