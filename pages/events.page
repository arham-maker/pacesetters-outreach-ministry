<div class="pom-page pom-page-events">
  <section class="pom-hero is-pew" data-pom-region="events-hero">
    <div class="pom-hero-copy pom-fallback"><h1 class="pom-sr">Events</h1></div>
    <div class="pom-cms"><squarespace:block-field id="events-hero" columns="12" /></div>
  </section>

  <section class="pom-split is-cream" data-pom-region="events-feature">
    <div class="pom-fallback">
      <div class="pom-media is-bible" role="img" aria-label="Saturday Night Live gathering"></div>
      <div class="pom-split-copy">
        <p class="pom-eyebrow">Weekly · Online via Zoom</p>
        <h2>Night Live</h2>
        <p>Join Pastor Michael Vance for preaching, music, prayer, and spiritual encouragement.</p>
        <a class="pom-link" href="#get-in-touch">Request Zoom Details <span class="pom-arrow" aria-hidden="true"></span></a>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-feature" columns="12" /></div>
  </section>

  <section class="pom-expect" data-pom-region="events-expect">
    <div class="pom-fallback">
      <p class="pom-eyebrow">What to expect</p>
      <article>
        <h3>Preaching</h3>
        <p>Biblical teaching to encourage and strengthen your faith.</p>
      </article>
      <article>
        <h3>Music</h3>
        <p>Worship through music that lifts our hearts to God.</p>
      </article>
      <article>
        <h3>Prayer &amp; encouragement</h3>
        <p>A time to pray together and receive encouragement for everyday life.</p>
      </article>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-expect" columns="12" /></div>
  </section>

  <section class="pom-event-block" data-pom-region="events-list">
    <div class="pom-fallback">
      <p class="pom-kicker">Gather with Us</p>
      <h2>Upcoming Gatherings</h2>
      <div class="pom-eventbar">
        <div><span>Weekly</span><strong>Saturday</strong></div>
        <div>
          <strong>Saturday Night Live</strong>
          <span>Pastor Micheal Vance · Online via Zoom</span>
        </div>
        <div>Timings Lorem Ipsum</div>
        <div>Joining Details Lorem Ipsum</div>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-list" columns="12" /></div>
  </section>

  <section class="pom-join" data-pom-region="events-join">
    <div class="pom-fallback">
      <div>
        <p class="pom-eyebrow">Joining Online</p>
        <h2>How to join</h2>
      </div>
      <div class="pom-steps">
        <article>
          <div class="pom-step-no">1</div>
          <h3>Contact the ministry</h3>
          <p>Ask for the current Zoom meeting details.</p>
        </article>
        <article>
          <div class="pom-step-no">2</div>
          <h3>Connect through Zoom</h3>
          <p>Use the meeting details provided by the ministry.</p>
        </article>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-join" columns="12" /></div>
  </section>

  <section class="pom-testimonials" data-pom-region="events-testimonials">
    <div class="pom-fallback">
      <div class="pom-testimonials-intro">
        <div>
          <p class="pom-eyebrow">Testimonials</p>
          <h2>Stories of faith and hope.</h2>
          <div class="pom-quote-nav">
            <button class="pom-icon-btn is-prev" type="button" data-quote="prev" aria-label="Previous story"><span class="pom-arrow"></span></button>
            <button class="pom-icon-btn is-next" type="button" data-quote="next" aria-label="Next story"><span class="pom-arrow"></span></button>
          </div>
        </div>
      </div>
      <div class="pom-quote-wrap" data-quotes>
        <blockquote class="pom-quote is-active">
          <div class="pom-quote-mark" aria-hidden="true">“</div>
          <p>Lorem ipsum dolor sit amet consectetur. Neque rhoncus et quis in pretium augue commodo. Eget est erat auctor sit nunc urna dolor massa eget. Aliquet praesent in laoreet orci turpis et faucibus. Egestas malesuada a ut auctor euismod.</p>
          <cite>— Jane Doe</cite>
        </blockquote>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-testimonials" columns="12" /></div>
  </section>

  <section class="pom-faq" data-pom-region="events-faq">
    <div class="pom-fallback">
      <div class="pom-faq-intro"><div><p class="pom-eyebrow">FAQ</p><h2>A few helpful answers.</h2></div></div>
      <div class="pom-faq-list" data-accordion>
        <div class="pom-faq-item is-open">
          <button class="pom-faq-q" type="button" aria-expanded="true">When does Saturday Night Live meet? <span class="pom-faq-icon" aria-hidden="true"></span></button>
          <div class="pom-faq-a">It meets weekly. Contact the ministry for the current time and Zoom access details.</div>
        </div>
        <div class="pom-faq-item"><button class="pom-faq-q" type="button" aria-expanded="false">Can I join from another state? <span class="pom-faq-icon" aria-hidden="true"></span></button><div class="pom-faq-a"></div></div>
        <div class="pom-faq-item"><button class="pom-faq-q" type="button" aria-expanded="false">Can I request prayer? <span class="pom-faq-icon" aria-hidden="true"></span></button><div class="pom-faq-a"></div></div>
      </div>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-faq" columns="12" /></div>
  </section>

  <section class="pom-contact is-crowd" id="get-in-touch" data-pom-region="events-contact">
    <div class="pom-fallback">
      <div>
        <p class="pom-eyebrow">Get in Touch</p>
        <h2>We’d love to hear from you.</h2>
        <p class="pom-contact-lead">Have a question, need prayer, or want to help?</p>
        <div class="pom-contact-meta">
          <a href="tel:3305059062">330-505-9062</a>
          <a href="mailto:larry.vicks@currently.com">larry.vicks@currently.com</a>
        </div>
      </div>
      <form class="pom-form-card" data-contact-form>
        <div class="pom-field"><label for="events-name">Name</label><input id="events-name" name="name" type="text"></div>
        <div class="pom-field"><label for="events-email">Email</label><input id="events-email" name="email" type="email"></div>
        <div class="pom-field"><label for="events-message">Message</label><textarea id="events-message" name="message"></textarea></div>
        <button class="pom-link" type="submit">Send Message <span class="pom-arrow" aria-hidden="true"></span></button>
        <p class="pom-form-note" hidden>Thank you. Add a Squarespace Form block in this region to deliver messages.</p>
      </form>
    </div>
    <div class="pom-cms"><squarespace:block-field id="events-contact" columns="12" /></div>
  </section>
</div>
