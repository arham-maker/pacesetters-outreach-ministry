<div class="pom-page pom-page-checkout">
  <div class="pom-page-checkout" data-unit-price="20.00" data-shipping="4.00">
    <section class="pom-checkout" data-pom-region="product-songs-of-encouragement-checkout">
      <div class="pom-fallback">
        <div class="pom-checkout-main">
          <a class="pom-back is-ink" href="/songs-of-encouragement"><span class="pom-arrow is-back" aria-hidden="true"></span> Back to Product</a>
          <h1>Checkout</h1>
          <p class="pom-lede">Complete your order and bring encouragement home.</p>

          <form class="pom-checkout-form" data-checkout-form novalidate>
            <div class="pom-checkout-section">
              <h2><span>01</span> Contact details</h2>
              <div class="pom-field"><label for="songs-of-encouragement-chk-name">Name</label><input id="songs-of-encouragement-chk-name" name="name" type="text" autocomplete="name" required></div>
              <div class="pom-field"><label for="songs-of-encouragement-chk-email">Email</label><input id="songs-of-encouragement-chk-email" name="email" type="email" autocomplete="email" required></div>
              <div class="pom-field"><label for="songs-of-encouragement-chk-phone">Phone number</label><input id="songs-of-encouragement-chk-phone" name="phone" type="tel" autocomplete="tel"></div>
            </div>

            <div class="pom-checkout-section">
              <h2><span>02</span> Shipping details</h2>
              <div class="pom-field"><label for="songs-of-encouragement-chk-street">Street Address</label><input id="songs-of-encouragement-chk-street" name="street" type="text" autocomplete="address-line1" required></div>
              <div class="pom-field"><label for="songs-of-encouragement-chk-apt">Apartment, Suite, etc. (Optional)</label><input id="songs-of-encouragement-chk-apt" name="apt" type="text" autocomplete="address-line2"></div>
              <div class="pom-field-row">
                <div class="pom-field"><label for="songs-of-encouragement-chk-city">City</label><input id="songs-of-encouragement-chk-city" name="city" type="text" autocomplete="address-level2" required></div>
                <div class="pom-field"><label for="songs-of-encouragement-chk-state">State</label><input id="songs-of-encouragement-chk-state" name="state" type="text" autocomplete="address-level1" required></div>
              </div>
              <div class="pom-field-row">
                <div class="pom-field"><label for="songs-of-encouragement-chk-zip">Zip Code</label><input id="songs-of-encouragement-chk-zip" name="zip" type="text" autocomplete="postal-code" required></div>
                <div class="pom-field"><label for="songs-of-encouragement-chk-country">Country</label><input id="songs-of-encouragement-chk-country" name="country" type="text" autocomplete="country-name" required></div>
              </div>
            </div>

            <div class="pom-checkout-section pom-checkout-payment" data-pom-region="product-songs-of-encouragement-payment">
              <div class="pom-fallback">
                <h2><span>03</span> Payment details</h2>
                <p class="pom-payment-empty">no payment method connected</p>
              </div>
              <div class="pom-cms"><squarespace:block-field id="product-songs-of-encouragement-payment" columns="12" /></div>
            </div>

            <label class="pom-check"><input type="checkbox" name="terms" required checked><span>I agree to the <a href="/terms">Terms &amp; Conditions</a> and <a href="/privacy">Privacy Policy</a>.</span></label>
            <button class="pom-btn-dark" type="submit"><span class="pom-link-text" data-order-pay>Pay $24.00</span><span class="pom-arrow is-ne" aria-hidden="true"></span></button>
            <p class="pom-form-error" data-checkout-error hidden>Please fill in all required fields to continue.</p>
          </form>
        </div>

        <aside class="pom-checkout-summary">
          <p class="pom-eyebrow">Your Order Summary</p>
          <h3>Songs of Encouragement.</h3>
          <p class="pom-product-cat">Music &amp; CDs</p>
          <div class="pom-media is-checkout-item is-product-p01" role="img" aria-label="Songs of Encouragement"></div>
          <div class="pom-summary-row">
            <span data-order-qty>Quantity : 01</span>
            <a class="pom-edit" href="/songs-of-encouragement">Edit</a>
          </div>
          <div class="pom-summary-lines">
            <div><span>Subtotal</span><strong data-order-subtotal>$20.00</strong></div>
            <div><span>Shipping</span><strong data-order-shipping>$4.00</strong></div>
            <div><span>Tax</span><strong>$0.00</strong></div>
          </div>
          <div class="pom-summary-total"><span>Total</span><strong data-order-total>$24.00</strong></div>
          <p class="pom-summary-note">Thank you for supporting Pacesetters Outreach Ministry.</p>
          <p class="pom-summary-help">Need help with your order? <a href="/contact">Contact us</a></p>
        </aside>
      </div>
      <div class="pom-cms"><squarespace:block-field id="product-songs-of-encouragement-checkout" columns="12" /></div>
    </section>

    <div class="pom-modal is-order-confirmed" data-order-modal hidden>
      <div class="pom-modal-card" role="dialog" aria-modal="true" aria-labelledby="songs-of-encouragement-order-success-title">
        <button class="pom-modal-close" type="button" data-modal-close aria-label="Close">&times;</button>
        <div class="pom-modal-check" aria-hidden="true"></div>
        <h2 id="songs-of-encouragement-order-success-title">Thank You for Your Purchase!</h2>
        <p>Your order for Songs of Encouragement is confirmed. We appreciate your support of the ministry.</p>
        <a class="pom-link" href="/store"><span class="pom-link-text">Back to Store</span><span class="pom-arrow is-ne" aria-hidden="true"></span></a>
      </div>
    </div>
  </div>

</div>
