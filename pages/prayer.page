            <div class="pom-field"><label for="prayer-email">Email</label><input id="prayer-email" name="email" type="email"></div>
            <div class="pom-field"><label for="prayer-message">Message</label><textarea id="prayer-message" name="message"></textarea></div>
            <button class="pom-link" type="submit"><span class="pom-link-text">Send Message</span><span class="pom-arrow is-ne" aria-hidden="true"></span></button>
          </form>
        </div>
        <div class="pom-cms"><squarespace:block-field id="prayer-contact-form" columns="12" /></div>
      </div>
    </div>
