<div class="pom-page pom-page-services">
  <section class="pom-hero is-candles" data-pom-region="services-hero">
    <div class="pom-hero-copy pom-fallback">
      <p class="pom-eyebrow">How We Serve</p>
      <h1>Faith in action.</h1>
      <p class="pom-lede">Compassion, prayer, and fellowship for our communities and beyond.</p>
