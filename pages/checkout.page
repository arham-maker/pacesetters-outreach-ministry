<div class="pom-page pom-page-checkout">
  <section class="pom-checkout" data-pom-region="checkout-main">
    <div class="pom-fallback">
      <div class="pom-checkout-main">
        <a class="pom-back is-ink" href="/product-details"><span class="pom-arrow is-back" aria-hidden="true"></span> Back to Product</a>
        <h1>Checkout</h1>
        <p class="pom-lede">Complete your order and bring encouragement home.</p>

        <form class="pom-checkout-form" data-checkout-form>
          <div class="pom-checkout-section">
            <h2><span>01</span> Contact details</h2>
            <div class="pom-field"><label for="chk-name">Name</label><input id="chk-name" name="name" type="text" autocomplete="name" required></div>
            <div class="pom-field"><label for="chk-email">Email</label><input id="chk-email" name="email" type="email" autocomplete="email" required></div>
            <div class="pom-field"><label for="chk-phone">Phone number</label><input id="chk-phone" name="phone" type="tel" autocomplete="tel"></div>
          </div>

          <div class="pom-checkout-section">
            <h2><span>02</span> Shipping details</h2>
            <div class="pom-field"><label for="chk-street">Street Address</label><input id="chk-street" name="street" type="text" autocomplete="address-line1" required></div>
            <div class="pom-field"><label for="chk-apt">Apartment, Suite, etc. (Optional)</label><input id="chk-apt" name="apt" type="text" autocomplete="address-line2"></div>
            <div class="pom-field-row">
              <div class="pom-field"><label for="chk-city">City</label><input id="chk-city" name="city" type="text" autocomplete="address-level2" required></div>
              <div class="pom-field"><label for="chk-state">State</label><input id="chk-state" name="state" type="text" autocomplete="address-level1" required></div>
            </div>
            <div class="pom-field-row">
              <div class="pom-field"><label for="chk-zip">Zip Code</label><input id="chk-zip" name="zip" type="text" autocomplete="postal-code" required></div>
              <div class="pom-field"><label for="chk-country">Country</label><input id="chk-country" name="country" type="text" autocomplete="country-name" required></div>
            </div>
          </div>

          <div class="pom-checkout-section">
            <h2><span>03</span> Payment details</h2>
            <div class="pom-field"><label for="chk-card">Card number</label><input id="chk-card" name="card" type="text" inputmode="numeric" autocomplete="cc-number" required></div>
            <div class="pom-field-row">
              <div class="pom-field"><label for="chk-exp">MM / YY</label><input id="chk-exp" name="exp" type="text" autocomplete="cc-exp" required></div>
              <div class="pom-field"><label for="chk-cvc">CVC</label><input id="chk-cvc" name="cvc" type="text" autocomplete="cc-csc" required></div>
            </div>
            <div class="pom-field"><label for="chk-cardname">Name on card</label><input id="chk-cardname" name="cardName" type="text" autocomplete="cc-name" required></div>
            <p class="pom-secure"><span class="pom-meta-icon is-lock" aria-hidden="true"></span> Your payment details are encrypted.</p>
            <label class="pom-check"><input type="checkbox" name="terms" required checked><span>I agree to the Terms &amp; Conditions and Privacy Policy.</span></label>
          </div>

          <button class="pom-btn-dark" type="submit"><span class="pom-link-text">Pay $24.00</span><span class="pom-arrow is-ne" aria-hidden="true"></span></button>
        </form>
      </div>

      <aside class="pom-checkout-summary">
        <p class="pom-eyebrow">Your Order Summary</p>
        <h3>Lorem Ipsum dolor sit amet.</h3>
        <p class="pom-product-cat">Music &amp; CDs</p>
        <div class="pom-media is-checkout-item" role="img" aria-label="Order item"></div>
        <div class="pom-summary-row">
          <span>Quantity : 01</span>
          <a class="pom-edit" href="/product-details">Edit</a>
        </div>
        <div class="pom-summary-lines">
          <div><span>Subtotal</span><strong>$20.00</strong></div>
          <div><span>Shipping</span><strong>$4.00</strong></div>
          <div><span>Tax</span><strong>$0.00</strong></div>
        </div>
        <div class="pom-summary-total"><span>Total</span><strong>$24.00</strong></div>
        <p class="pom-summary-note">Thank you for supporting Pacesetters Outreach Ministry.</p>
        <p class="pom-summary-help">Need help with your order? <a href="/contact">Contact us</a></p>
      </aside>
    </div>
    <div class="pom-cms"><squarespace:block-field id="checkout-main" columns="12" /></div>
  </section>

  <div class="pom-modal" data-order-modal hidden>
    <div class="pom-modal-card" role="dialog" aria-modal="true" aria-labelledby="order-success-title">
      <button class="pom-modal-close" type="button" data-modal-close aria-label="Close">&times;</button>
      <div class="pom-modal-check" aria-hidden="true"></div>
      <h2 id="order-success-title">Thank You for Your Purchase!</h2>
      <p>Lorem ipsum dolor sit amet consectetur. Neque rhoncus et quis in pretium augue commodo.</p>
      <a class="pom-link is-gold" href="/store"><span class="pom-link-text">Back to Store</span><span class="pom-arrow is-ne" aria-hidden="true"></span></a>
    </div>
  </div>
</div>
