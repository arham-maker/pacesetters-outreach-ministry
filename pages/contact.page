<div class="pom-page pom-page-contact">
  <section class="pom-contact is-crowd" id="get-in-touch" data-pom-region="contact-main">
    <div class="pom-fallback">
      <div>
        <p class="pom-eyebrow">Get in Touch</p>
        <h2>We’d love to hear from you.</h2>
        <p class="pom-contact-lead">Have a question, need prayer, or want to help?</p>
        <div class="pom-contact-meta">
          <a href="tel:3305059062">330-505-9062</a>
          <a href="mailto:larry.vicks@currently.com">larry.vicks@currently.com</a>
        </div>
      </div>
      <form class="pom-form-card" data-contact-form>
        <div class="pom-field"><label for="contact-name">Name</label><input id="contact-name" name="name" type="text" autocomplete="name"></div>
        <div class="pom-field"><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email"></div>
        <div class="pom-field"><label for="contact-message">Message</label><textarea id="contact-message" name="message"></textarea></div>
        <button class="pom-link" type="submit">Send Message <span class="pom-arrow" aria-hidden="true"></span></button>
        <p class="pom-form-note" hidden>Thank you. Add a Squarespace Form block in this region to deliver messages.</p>
      </form>
    </div>
    <div class="pom-cms"><squarespace:block-field id="contact-main" columns="12" /></div>
  </section>
</div>
